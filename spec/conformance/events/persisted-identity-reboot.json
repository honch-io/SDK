{
  "name": "persisted identity reboot",
  "description": "When a port has persistent state storage, a previously identified distinct_id persists across reboot and applies to events tracked before the next identify call",
  "applies_when": {
    "state_storage": "persistent"
  },
  "config": {
    "api_key": "test-key",
    "device_id": "dev_fixture",
    "device_model": "FixtureBoard",
    "firmware_version": "1.2.3",
    "environment": "test"
  },
  "operations": [
    {
      "op": "identify",
      "distinct_id": "user_123",
      "traits": {
        "plan": "beta"
      }
    },
    {
      "op": "reboot"
    },
    {
      "op": "track",
      "event": "pre_identify_after_reboot",
      "properties": {}
    }
  ],
  "expect": {
    "pre_identify_distinct_id_after_reboot": "user_123",
    "queued_events_after_reboot": [
      "pre_identify_after_reboot"
    ]
  }
}
