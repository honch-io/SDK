{
  "name": "invalid-reserved-property-override",
  "description": "An event tries to override a promoted context key ($device_id) in its own properties. Per-event overrides of promoted context are rejected.",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.3.0"
      },
      "events": [
        {
          "event": "boot",
          "timestamp": 1700000000000,
          "properties": { "$device_id": "spoofed" }
        }
      ]
    }
  },
  "expected_ingest_status": 422,
  "expected_error_codes": ["reserved_property"]
}
