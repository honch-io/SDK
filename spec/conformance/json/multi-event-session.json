{
  "name": "multi-event-session",
  "description": "Multiple events in one request sharing context, including a session id and a lifecycle event with a reserved property (session_name).",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.4",
        "$environment": "production",
        "$session_id": "session-1"
      },
      "events": [
        {
          "event": "$session_start",
          "timestamp": 1700000000000,
          "properties": { "session_name": "recording" }
        },
        {
          "event": "frame_captured",
          "timestamp": 1700000000500,
          "properties": { "index": 1 }
        }
      ]
    }
  },
  "expected_ingest_status": 200,
  "expected_expanded_events": [
    {
      "distinct_id": "user-1",
      "event": "$session_start",
      "properties": {
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$environment": "production",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.4",
        "$session_id": "session-1",
        "session_name": "recording"
      },
      "timestamp": 1700000000000
    },
    {
      "distinct_id": "user-1",
      "event": "frame_captured",
      "properties": {
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$environment": "production",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.4",
        "$session_id": "session-1",
        "index": 1
      },
      "timestamp": 1700000000500
    }
  ]
}
