{
  "name": "partial-batch",
  "description": "A batch mixing valid and invalid events. The valid events are stored and the invalid ones are reported, demonstrating partial acceptance (200 with rejected > 0). Event 1 has an empty name; event 2 has a non-numeric $battery_level.",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.3.0"
      },
      "events": [
        { "event": "boot", "timestamp": 1700000000000 },
        { "event": "", "timestamp": 1700000001000 },
        { "event": "$battery_low", "timestamp": 1700000002000, "properties": { "$battery_level": "low" } },
        { "event": "sample", "timestamp": 1700000003000, "properties": { "n": 1 } }
      ]
    }
  },
  "expected_ingest_status": 200,
  "expected_accepted": 2,
  "expected_rejected": 2,
  "expected_error_codes": ["invalid_event", "invalid_property_value"],
  "expected_expanded_events": [
    {
      "distinct_id": "user-1",
      "event": "boot",
      "properties": {
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$environment": "production",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.3.0"
      },
      "timestamp": 1700000000000
    },
    {
      "distinct_id": "user-1",
      "event": "sample",
      "properties": {
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$environment": "production",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.3.0",
        "n": 1
      },
      "timestamp": 1700000003000
    }
  ]
}
