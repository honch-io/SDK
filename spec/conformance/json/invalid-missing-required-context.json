{
  "name": "invalid-missing-required-context",
  "description": "Required context key $device_id is absent. Rejected with a descriptive error.",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.3.1"
      },
      "events": [
        { "event": "boot", "timestamp": 1700000000000 }
      ]
    }
  },
  "expected_ingest_status": 422,
  "expected_error_codes": ["missing_context_key"]
}
