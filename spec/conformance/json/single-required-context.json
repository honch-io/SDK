{
  "name": "single-required-context",
  "description": "Minimal valid request: one event and only required context. Expands to the same canonical event as the wire-v2 fixture of the same name.",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.4",
        "$environment": "production"
      },
      "events": [
        { "event": "boot", "timestamp": 1700000000000 }
      ]
    }
  },
  "expected_ingest_status": 200,
  "expected_expanded_events": [
    {
      "distinct_id": "user-1",
      "event": "boot",
      "properties": {
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$environment": "production",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.4"
      },
      "timestamp": 1700000000000
    }
  ]
}
