{
  "name": "invalid-empty-batch",
  "description": "events is empty. A request must contain at least one event.",
  "wire_format": "honch-json-v1",
  "request": {
    "method": "POST",
    "path": "/capture",
    "headers": {
      "Content-Type": "application/json",
      "X-Honch-Project-Key": "<project_api_key>"
    },
    "body": {
      "context": {
        "distinct_id": "user-1",
        "$device_id": "device-1",
        "$device_model": "model-x",
        "$firmware_version": "1.0.0",
        "$sdk_platform": "posix",
        "$sdk_version": "0.2.2"
      },
      "events": []
    }
  },
  "expected_ingest_status": 422,
  "expected_error_codes": ["empty_batch"]
}
