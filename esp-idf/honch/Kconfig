menu "Honch SDK"

    config HONCH_LOG_VERBOSE
        bool "Enable verbose logging"
        default n
        help
            Enable extra debug logging from the Honch SDK.
            Adds detailed logs for queue operations, encoding,
            and transport activity.

    config HONCH_MAX_QUEUE_DEPTH
        int "Maximum event queue depth"
        default 256
        range 16 1024
        help
            Maximum number of events that can be stored in the
            NVS-backed queue before the oldest events are dropped.

    config HONCH_ENABLE_GZIP
        bool "Enable gzip compression for large CBOR batches"
        default y
        help
            Compress HTTP CBOR batches when they are large enough to benefit.
            If compression fails or does not reduce the payload, the SDK sends
            the original raw CBOR body.

    config HONCH_GZIP_MIN_BYTES
        int "Minimum CBOR payload size for gzip"
        default 1024
        range 0 65536
        depends on HONCH_ENABLE_GZIP
        help
            Minimum encoded CBOR batch size before the SDK attempts gzip.
            Smaller batches are sent as raw application/cbor.

endmenu
