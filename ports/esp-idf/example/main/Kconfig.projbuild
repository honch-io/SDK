menu "Honch Example Configuration"

    config HONCH_API_KEY
        string "Honch API Key"
        default ""
        help
            Your Honch project API key.

    config HONCH_HOST
        string "Honch Host"
        default "https://capture.honch.io"
        help
            The Honch capture endpoint URL.

    config WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            SSID of the Wi-Fi network to connect to.

    config WIFI_PASSWORD
        string "Wi-Fi Password"
        default ""
        help
            Password for the Wi-Fi network.

    config HONCH_IDENTIFY_PILOT
        bool "Run one-shot identify pilot validation"
        default n
        help
            Sends a pre-identify event, identify call, post-identify event, and
            flush with serial markers for real ESP32 hardware validation.

endmenu
